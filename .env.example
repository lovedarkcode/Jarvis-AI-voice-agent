# MARK LIII — environment configuration
#
# Copy this file to `.env` (same folder as main.py) and fill in your key.
# `.env` is gitignored: it is the only place the API key ever lives, and the
# app never writes to it.
#
#     cp .env.example .env
#
# Free Gemini API key: https://aistudio.google.com/apikey

GEMINI_API_KEY=your_key_here

# Optional. Which platform the OS-specific actions should target.
# Leave it unset and the app detects it: windows | mac | linux
# OS_SYSTEM=windows

# Optional. Set to false to keep uploaded document text on this machine —
# document search then uses local keyword matching only, with no embedding
# calls. Default: true
# DOCUMENT_EMBEDDINGS=true
